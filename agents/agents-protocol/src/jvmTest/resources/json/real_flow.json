{
  "id": "real-flow",
  "version": "1.0.0",
  "description": "Real flow for testing purposes.",
  "defaultModel": "openai/gpt4o",
  "agents": [
    {
      "name": "open-jetbrains-site",
      "type": "task",
      "prompt": {
        "system": "You are a Playwright agent. You can open a browser and navigate to sites using tools"
      },
      "params": {
        "task": "Open a browser, navigate to jetbrains.com, accept all cookies, click AI in toolbar"
      }
    }
  ],
  "tools": [
    {
      "name": "Playwright-mcp",
      "type": "mcp",
      "parameters": {
        "transport": "stdio",
        "command": "npx",
        "args": ["@playwright/mcp@latest", "--port", "8931"]
      }
    }
  ]
}
